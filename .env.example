# ===========================================
# BoxCall Environment Configuration
# ===========================================

# Client-side Supabase Configuration (Safe to commit)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Performance & Development Settings
VITE_BACKUP_INTERVAL=300000
VITE_CACHE_TTL=300000
VITE_MAX_CACHE_SIZE=1000
VITE_ENVIRONMENT=development
VITE_DEBUG_PERFORMANCE=true
VITE_SUPER_ADMIN_EMAIL=super.admin@example.com
SUPER_ADMIN_EMAIL=super.admin@example.com
VITE_DEFAULT_DEV_MODE=blank_slate
VITE_FORCE_DEV_MODE=none

# PWA Configuration
VITE_ENABLE_PWA=false

# Development helpers (optional)
VITE_DEV_PASSWORD=your_dev_password_here

# ===========================================
# ANALYTICS & ERROR TRACKING
# ===========================================

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=
VITE_GA_DEBUG=false

# PostHog Analytics
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=https://app.posthog.com
VITE_POSTHOG_DEBUG=false

# Sentry Error Tracking
VITE_SENTRY_DSN=
VITE_ENABLE_SENTRY=false
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# Custom Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_API_KEY=

# Analytics Settings
VITE_ANALYTICS_DEV=false
VITE_ANALYTICS_DEBUG=false
VITE_ANALYTICS_BATCH_SIZE=10
VITE_ANALYTICS_FLUSH_INTERVAL=5000

# ===========================================
# DATABASE OPTIMIZATION
# ===========================================

# Cache Configuration
VITE_DB_CACHE_TTL=300000
VITE_DB_MAX_CACHE_SIZE=1000
VITE_DB_ENABLE_QUERY_CACHE=true
VITE_DB_ENABLE_SERVICE_CACHE=true
VITE_DB_CACHE_CLEANUP_INTERVAL=60000

# Performance Configuration
VITE_SLOW_QUERY_THRESHOLD=1000
VITE_DB_ENABLE_METRICS=true
VITE_DB_ENABLE_QUERY_LOGGING=false
VITE_DB_METRICS_RETENTION=1000
VITE_DB_PERF_MONITOR_INTERVAL=5000

# Connection Configuration
VITE_DB_CONNECTION_POOL_SIZE=5
VITE_DB_MAX_RETRIES=3
VITE_DB_RETRY_DELAY=1000
VITE_DB_TIMEOUT=30000

# Optimization Configuration
VITE_DB_ENABLE_BATCHING=true
VITE_DB_DEFAULT_BATCH_SIZE=100
VITE_DB_ENABLE_OPTIMIZATION=true
VITE_DB_ENABLE_CONNECTION_POOLING=true

# Development Configuration
VITE_DB_DEBUG_MODE=false
VITE_DB_LOG_LEVEL=info
VITE_DB_ENABLE_QUERY_EXPLAIN=false
VITE_DB_ENABLE_PERF_TRACING=false

# ===========================================
# CDN & ASSET OPTIMIZATION
# ===========================================

# CDN Configuration
VITE_CDN_URL=
VITE_ENABLE_IMAGE_OPTIMIZATION=true
VITE_IMAGE_QUALITY=85

# Image Format Support
VITE_ENABLE_WEBP=true
VITE_ENABLE_AVIF=false

# Cache Control Headers
VITE_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
VITE_SCRIPT_CACHE_CONTROL=public, max-age=31536000, immutable
VITE_STYLE_CACHE_CONTROL=public, max-age=31536000, immutable
VITE_FONT_CACHE_CONTROL=public, max-age=31536000, immutable

# Preloading Settings
VITE_PRELOAD_CRITICAL_IMAGES=true
VITE_MAX_CONCURRENT_PRELOADS=3
VITE_PREFETCH_ON_IDLE=true
VITE_ROUTE_PRELOADING=true

# Performance Settings
VITE_MAX_IMAGE_SIZE=2097152
VITE_LAZY_LOADING_THRESHOLD=0.1
VITE_LAZY_LOADING_ROOT_MARGIN=50px
VITE_CRITICAL_IMAGE_TIMEOUT=3000

# Development CDN Settings
VITE_DEV_ENABLE_OPTIMIZATION=false
VITE_DEV_MOCK_CDN=false
VITE_DEV_SHOW_PERFORMANCE=true

# ===========================================
# SERVER-SIDE ONLY (Never commit real values!)
# ===========================================
# These should be in .env.local (gitignored)

# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
