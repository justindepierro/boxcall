# ===========================================
# BoxCall Environment Configuration
# ===========================================

# Client-side Supabase Configuration (Safe to commit)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Performance & Development Settings
VITE_BACKUP_INTERVAL=300000
VITE_CACHE_TTL=300000
VITE_MAX_CACHE_SIZE=1000
VITE_ENVIRONMENT=development
VITE_DEBUG_PERFORMANCE=true

# ===========================================
# SERVER-SIDE ONLY (Never commit real values!)
# ===========================================
# These should be in .env.local (gitignored)

# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
