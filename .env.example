# Client (exposed) Supabase vars
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Performance / Dev (examples)
VITE_BACKUP_INTERVAL=300000
VITE_CACHE_TTL=300000
VITE_MAX_CACHE_SIZE=1000
VITE_ENVIRONMENT=development
VITE_DEBUG_PERFORMANCE=true

# Server-side ONLY (not prefixed; never commit real service key)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_LOCALLY_ONLY
