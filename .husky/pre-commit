echo "🔍 Running pre-commit checks..."

# Type check
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Fix errors before committing."
  exit 1
}

# Lint (allow existing warnings for now, but no new errors)
echo "🧹 Linting..."
npm run lint || {
  echo "❌ Lint failed with errors. Fix critical issues before committing."
  exit 1
}

# Format check
echo "💅 Format checking..."
npm run format:check || {
  echo "⚠️  Format check failed. Consider running 'npm run format' to fix."
  echo "   (Continuing anyway - formatting is not blocking)"
}

echo "✅ Pre-commit checks passed!"

