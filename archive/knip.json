{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx"],
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "workspaces": {
    ".": {}
  },
  "ignoreDependencies": [
    "vite-bundle-analyzer",
    "lighthouse",
    "@testing-library/jest-dom",
    "@testing-library/user-event",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "husky",
    "lint-staged"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "src/styles/generated-*.css",
    "archive/**",
    "public/sw.js",
    "scripts/**"
  ],
  "exclude": ["types", "nsTypes"],
  "vite": true,
  "vitest": true,
  "react-router": true,
  "eslint": true,
  "husky": true,
  "lint-staged": true,
  "playwright": true
}
