{
  "name": "boxcall-mobile",
  "version": "1.0.0",
  "description": "BoxCall Cross-Platform Mobile Application - Intelligent Calendar Management for Teams",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "detox test",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "build:ios:debug": "react-native run-ios --configuration Debug",
    "build:ios:release": "react-native run-ios --configuration Release",
    "build:android:debug": "react-native run-android --variant=debug",
    "build:android:release": "react-native run-android --variant=release",
    "deploy:ios": "cd ios && fastlane release",
    "deploy:android": "cd android && fastlane release",
    "postinstall": "cd ios && pod install",
    "clean": "react-native clean-project-auto",
    "reset-cache": "react-native start --reset-cache",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-calendar-events/calendar-events": "^2.4.0",
    "@react-native-community/datetimepicker": "^7.6.2",
    "@react-native-community/netinfo": "^11.2.1",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-query": "^5.17.0",
    "date-fns": "^3.0.6",
    "react": "18.2.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.73.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-calendars": "^1.1301.0",
    "react-native-camera": "^4.2.1",
    "react-native-date-picker": "^4.3.3",
    "react-native-device-info": "^10.11.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-image-picker": "^7.0.3",
    "react-native-keychain": "^8.1.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.10.0",
    "react-native-modal": "^13.0.1",
    "react-native-orientation-locker": "^1.6.0",
    "react-native-permissions": "^4.0.4",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "^3.6.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-swipe-gestures": "^1.0.5",
    "react-native-vector-icons": "^10.0.3",
    "react-redux": "^9.0.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "babel-jest": "^29.6.3",
    "detox": "^20.13.5",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "calendar",
    "scheduling",
    "team-management",
    "sports",
    "intelligent-scheduling",
    "cross-platform",
    "mobile"
  ],
  "author": "BoxCall Development Team",
  "license": "Proprietary",
  "private": true,
  "workspaces": [
    "../../shared"
  ]
}
