{
  "name": "boxcall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/telemetry/**/*",
    "./src/lib/supabase.ts",
    "./src/app/store.ts"
  ],
  "description": "Football program management platform - everything Hudl is not. Collaborative, social, and comprehensive.",
  "author": "Justin DePierro",
  "repository": {
    "type": "git",
    "url": "https://github.com/justindepierro/boxcall.git"
  },
  "keywords": [
    "football",
    "coaching",
    "playbook",
    "team-management",
    "AI",
    "analytics"
  ],
  "scripts": {
    "predev": "lsof -ti :5173 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run predev && vite --open",
    "dev:debug": "npm run predev && vite --debug",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsc && vite build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:optimized": "NODE_OPTIONS='--max-old-space-size=4096' tsc && ANALYZE=true vite build",
    "build:parallel": "NODE_OPTIONS='--max-old-space-size=4096' concurrently \"npm run type-check\" \"npm run lint\" && vite build",
    "build:monitor": "npm run build && tsx scripts/bundle-monitor.ts",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 200",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:ci": "vitest run --project=unit",
    "test:storybook:vitest": "vitest run --project=storybook",
    "test:watch": "vitest --watch --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:coverage:ui": "vitest run --project=unit --coverage --ui",
    "test:coverage:open": "vitest run --project=unit --coverage && open coverage/index.html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test visual-regression.spec.ts",
    "test:visual:update": "playwright test visual-regression.spec.ts --update-snapshots",
    "test:visual:ui": "playwright test visual-regression.spec.ts --ui",
    "clean": "rm -rf dist coverage .eslintcache",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "tokens:generate": "tsx scripts/generate-token-css.ts",
    "security:audit": "tsx scripts/security-audit.ts",
    "security:deps": "npm audit",
    "security:check": "npm run security:audit && npm run security:deps",
    "db": "node scripts/cli/db-cli.js",
    "db:status": "node scripts/cli/db-cli.js status",
    "db:migrate": "node scripts/cli/db-cli.js migrate",
    "db:migrate:run": "node scripts/cli/migrate-cli.js",
    "db:migrate:easy": "bash -c 'cat \"$1\" | pbcopy && open \"https://supabase.com/dashboard/project/lvmuiqwihlpnwppdqqfl/sql/new\" && echo \"✅ SQL copied! Paste (Cmd+V) in editor and click Run\"' -- ",
    "db:sql": "node scripts/cli/db-cli.js sql-editor",
    "db:schema": "tsx scripts/apply-schema.ts",
    "migrate:rls": "./scripts/migrate.sh",
    "db:admin": "tsx scripts/setup-admin.ts",
    "db:demo": "tsx scripts/setup-demo.ts",
    "db:setup": "npm run db:schema && npm run db:admin && npm run db:demo",
    "db:drop-script": "tsx scripts/generate-drop-script.ts",
    "backup": "tsx scripts/backup/backup-database.ts",
    "backup:verify": "tsx scripts/backup/verify-backup.ts",
    "db:reload-cache": "tsx scripts/reload-schema-cache.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npm run build-storybook --quiet && npx http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && npm run test:storybook\"",
    "test:storybook:visual": "test-storybook",
    "test:storybook:update": "test-storybook --updateSnapshots",
    "deadcode:scan": "node scripts/find-dead-code.mjs",
    "deadcode:report": "node scripts/find-dead-code.mjs > reports/dead-code-report.txt",
    "migrate:copy": "./scripts/migrations/copy_migration.sh",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/react": "^10.16.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.90.5",
    "@tiptap/extension-color": "^3.7.2",
    "@tiptap/extension-font-family": "^3.7.2",
    "@tiptap/extension-highlight": "^3.7.2",
    "@tiptap/extension-image": "^3.7.2",
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-mention": "^3.7.2",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/extension-text-style": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "@tiptap/suggestion": "^3.7.2",
    "@types/react-window": "^1.8.8",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "fuse.js": "^7.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.536.0",
    "pixi.js": "^8.14.0",
    "prosemirror-view": "^1.41.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "react-virtuoso": "^4.10.0",
    "react-window": "^1.8.11",
    "recharts": "^3.3.0",
    "resend": "^6.2.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.14",
    "tippy.js": "^6.3.7",
    "uuid": "^13.0.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.55.1",
    "@storybook/addon-a11y": "^9.1.15",
    "@storybook/addon-docs": "^9.1.15",
    "@storybook/addon-onboarding": "^9.1.15",
    "@storybook/addon-vitest": "^9.1.15",
    "@storybook/react": "^9.1.15",
    "@storybook/react-vite": "^9.1.15",
    "@storybook/test-runner": "^0.23.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "4.0.4",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/ui": "^4.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.8",
    "globals": "^16.3.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.30.1",
    "lint-staged": "^15.5.2",
    "pg": "^8.16.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^9.1.8",
    "ts-morph": "^23.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.0.4",
    "web-vitals": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prepare": "husky install",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
