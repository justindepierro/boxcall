{
  "name": "boxcall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/telemetry/**/*",
    "./src/lib/supabase.ts",
    "./src/app/store.ts"
  ],
  "description": "Football program management platform - everything Hudl is not. Collaborative, social, and comprehensive.",
  "author": "Justin DePierro",
  "repository": {
    "type": "git",
    "url": "https://github.com/justindepierro/boxcall.git"
  },
  "keywords": [
    "football",
    "coaching",
    "playbook",
    "team-management",
    "AI",
    "analytics"
  ],
  "scripts": {
    "dev": "vite --open",
    "dev:clean": "lsof -ti :5173 | xargs kill -9 2>/dev/null || true && vite --open",
    "build": "tsc && vite build",
    "build:only": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "postinstall": "patch-package",
    "lint": "eslint src --max-warnings 600",
    "lint:strict": "eslint src --max-warnings 100",
    "lint:fix": "eslint src --fix",
    "lint:fix-all": "eslint src --fix && prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf dist coverage .eslintcache",
    "perf:budgets": "node scripts/perf/check-budgets.mjs",
    "security:client-secrets": "node scripts/security/check-client-secrets.mjs",
    "validate": "tsc --noEmit && eslint src --max-warnings 600 && npm run security:client-secrets && vitest run && npm run build:only && npm run perf:budgets",
    "check:consistency": "npm run format:check && npm run lint && npm run type-check",
    "find:todos": "grep -rn --include=\\*.{ts,tsx} 'TODO\\|FIXME\\|HACK\\|XXX' src/ || echo 'No TODOs found'",
    "find:console": "grep -rnE --include='*.ts' --include='*.tsx' 'console\\.(log|warn|debug)' src/ | grep -v 'ErrorTrackingService' || echo 'No console statements found'",
    "db": "node scripts/cli/db-cli.js",
    "db:status": "node scripts/cli/db-cli.js status",
    "db:migrate": "node scripts/cli/db-cli.js migrate",
    "db:migrate:easy": "bash -c 'cat \"$1\" | pbcopy && open \"https://supabase.com/dashboard/project/lvmuiqwihlpnwppdqqfl/sql/new\" && echo \"✅ SQL copied!\"'",
    "db:types": "supabase gen types typescript --project-id lvmuiqwihlpnwppdqqfl > src/types/database.ts",
    "security:audit": "tsx scripts/security-audit.ts",
    "deadcode:scan": "node scripts/find-dead-code.mjs",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/react": "^10.16.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.90.5",
    "@tiptap/extension-color": "^3.7.2",
    "@tiptap/extension-highlight": "^3.7.2",
    "@tiptap/extension-image": "^3.7.2",
    "@tiptap/extension-mention": "^3.7.2",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/extension-text-style": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "@tiptap/suggestion": "^3.7.2",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "fuse.js": "^7.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intersection-observer": "^10.0.0",
    "react-router-dom": "^7.8.0",
    "react-virtuoso": "^4.10.0",
    "recharts": "^3.3.0",
    "resend": "^6.2.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.14",
    "tippy.js": "^6.3.7",
    "use-debounce": "^10.0.6",
    "web-vitals": "^5.1.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vheemstra/vite-plugin-imagemin": "^2.2.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^11.0.1",
    "imagemin-webp": "^8.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tsx": "^4.20.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
