{
  "name": "boxcall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Football program management platform - everything Hudl is not. Collaborative, social, and comprehensive.",
  "author": "Justin DePierro",
  "repository": {
    "type": "git",
    "url": "https://github.com/justindepierro/boxcall.git"
  },
  "keywords": [
    "football",
    "coaching",
    "playbook",
    "team-management",
    "AI",
    "analytics"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 20",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist coverage .eslintcache",
    "validate": "npm run type-check && npm run lint && npm run test",
    "security:audit": "tsx scripts/security-audit.ts",
    "security:deps": "npm audit",
    "security:check": "npm run security:audit && npm run security:deps",
    "db:schema": "tsx scripts/apply-schema.ts",
    "db:admin": "tsx scripts/setup-admin.ts",
    "db:demo": "tsx scripts/setup-demo.ts",
    "db:setup": "npm run db:schema && npm run db:admin && npm run db:demo",
    "db:drop-script": "tsx scripts/generate-drop-script.ts",
    "db:reload-cache": "tsx scripts/reload-schema-cache.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/react": "^10.16.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.84.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "fuse.js": "^7.1.0",
    "gtag": "^1.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.536.0",
    "posthog-js": "^1.268.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "react-virtuoso": "^4.10.0",
    "tailwindcss": "^3.4.14",
    "workbox-window": "^7.3.0",
    "zod": "^4.0.14",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@chromatic-com/storybook": "^4.1.1",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.30.1",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^9.1.8",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-onboarding": "^9.1.8",
    "@storybook/addon-vitest": "^9.1.8",
    "@storybook/react": "^9.1.8",
    "@storybook/react-vite": "^9.1.8",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.3",
    "bundlesize": "^0.18.2",
    "concurrently": "^9.0.0",
    "dependency-cruiser": "^16.10.4",
    "dotenv": "^17.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.8",
    "globals": "^16.3.0",
    "globby": "^14.1.0",
    "husky": "^9.1.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "knip": "^5.62.0",
    "lighthouse": "^12.8.1",
    "lightningcss": "^1.30.1",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "storybook": "^9.1.8",
    "ts-morph": "^23.0.0",
    "ts-unused-exports": "^11.0.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "7.0.4",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prepare": "husky install",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
