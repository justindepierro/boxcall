{
  "name": "boxcall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Football program management platform - everything Hudl is not. Collaborative, social, and comprehensive.",
  "author": "Justin DePierro",
  "repository": {
    "type": "git",
    "url": "https://github.com/justindepierro/boxcall.git"
  },
  "keywords": [
    "football",
    "coaching",
    "playbook",
    "team-management",
    "AI",
    "analytics"
  ],
  "scripts": {
    "predev": "npm run type-check && npm run lint",
    "dev": "npm run predev && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite .eslintcache tsconfig.tsbuildinfo && npm cache clean --force",
    "fresh-start": "npm run clean && npm install && npm run dev",
    "clear-stale": "echo '🧹 Clear stale VS Code references: Cmd+Shift+P → TypeScript: Restart TS Server & ESLint: Restart ESLint Server' && ./scripts/clear-stale-references.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli": "^19.1.1",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/stack": "^7.4.4",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/react-query": "^5.84.1",
    "@tensorflow/tfjs": "^4.22.0",
    "chart.js": "^4.4.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fabric": "^6.4.5",
    "framer-motion": "^12.1.3",
    "fuse.js": "^7.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.536.0",
    "papaparse": "^5.4.1",
    "react": "^19.1.0",
    "react-calendar": "^5.1.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-mentions": "^4.4.10",
    "react-native": "^0.80.2",
    "react-native-calendars": "^1.1313.0",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "^2.27.2",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "^4.0.1",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.1.0",
    "slate": "^0.112.0",
    "slate-react": "^0.113.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.14",
    "zod": "^4.0.14",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@storybook/addon-links": "^9.1.0",
    "@storybook/addon-onboarding": "^9.1.0",
    "@storybook/react": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/fabric": "^5.3.9",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "storybook": "^9.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
