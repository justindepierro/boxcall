-- Migration: 025 - Security Fix
-- Purpose: Implement proper team-based RLS policies
-- Date: September 23, 2025

-- Drop overly restrictive policies
DROP POLICY IF EXISTS "profiles_secure" ON profiles;
DROP POLICY IF EXISTS "team_posts_secure" ON team_posts;

-- Proper team-based policies for profiles
CREATE POLICY "profiles_select_team_members" ON profiles FOR SELECT USING (
  id = auth.uid() OR
  id IN (
    SELECT tm.user_id FROM public.team_members tm
    WHERE tm.team_id IN (
      SELECT tm2.team_id FROM public.team_members tm2
      WHERE tm2.user_id = auth.uid() AND tm2.status = 'active'
    ) AND tm.status = 'active'
  )
);

CREATE POLICY "profiles_self_manage" ON profiles FOR ALL USING (id = auth.uid());

-- Proper team-based policies for team_posts (already handled in migration 022/023)
-- This migration is now redundant but kept for migration history
